# =====================================================================
# Kitsuy Store — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite o .env.local ou qualquer arquivo com credenciais reais.
# Veja SETUP_CHECKOUT.md para o passo a passo de onde obter cada uma.
# =====================================================================

# ── Mercado Pago ──────────────────────────────────────────────────────
VITE_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── SuperFrete ────────────────────────────────────────────────────────
SUPERFRETE_TOKEN=
LOJA_CEP_ORIGEM=

# ── Firebase Admin (backend — NUNCA expor no frontend) ──────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Firebase Client (frontend — já usado pelo site) ─────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Resend (email transacional) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_LOJA_NOTIFICACAO=
EMAIL_REMETENTE=

# ── Geral ────────────────────────────────────────────────────────────
VITE_SITE_URL=
