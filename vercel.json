{
  "framework": null,
  "functions": {
    "api/seo.ts": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/produto/:slug", "destination": "/api/seo?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/seo?sitemap=1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/cron/limpar-pedidos-expirados",
      "schedule": "0 6 * * *"
    }
  ]
}
